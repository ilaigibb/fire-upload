[Unit]
Description=File Upload
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/file-upload.env
ExecStart=/usr/bin/node /opt/file-upload/current/server.js
Restart=on-failure
RestartSec=3
User=file-upload
Group=file-upload
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/file-upload

[Install]
WantedBy=multi-user.target
